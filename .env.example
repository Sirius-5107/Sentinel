# Sentinel — Environment Variable Template
# Copy this file to .env and populate the values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────
SENTINEL_DB_HOST=localhost
SENTINEL_DB_PORT=5432
SENTINEL_DB_NAME=sentinel
SENTINEL_DB_USER=sentinel
SENTINEL_DB_PASSWORD=sentinel
SENTINEL_DB_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel

# ── LLM Providers ─────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Notion ────────────────────────────────────────────────────
NOTION_API_KEY=
NOTION_WORKSPACE_ID=

# ── Application ───────────────────────────────────────────────
SENTINEL_ENV=development
SENTINEL_LOG_LEVEL=DEBUG
